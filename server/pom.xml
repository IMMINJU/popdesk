<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.popdesk</groupId>
    <artifactId>popdesk-server</artifactId>
    <version>0.4.0</version>
    <name>popdesk-server</name>
    <description>popdesk server: one Spring Boot app serving the customer portal and the agent console</description>
    <url>https://github.com/IMMINJU/popdesk</url>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <!-- Not managed by Spring Boot. Latest GA on Maven Central. -->
        <spring-modulith.version>2.1.1</spring-modulith.version>
        <springdoc.version>3.1.1</springdoc.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <awssdk.version>2.55.15</awssdk.version>
        <!-- Newer than Spring Boot 4.1.1 manages, for security fixes (trivy, C-10): Tomcat
             CVE-2026-65182, -65905, -68525; Jackson CVE-2026-68497, -89407, -89425, -91776, -91777.
             Remove each line when the Spring Boot version manages that version or a later one. -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- Small heap and one JVM for tests: the dev machine has 16 GB (ADR D-3). -->
        <!-- The tests send their own Host header. The JDK HTTP client reads this property once, when it
             is first used, so it is set for the whole test JVM and not by whichever test class loads first. -->
        <!-- Heap of the test JVM. 512m fits the 16 GB dev PC, where tests run a package at a time. CI runs
             every class in one JVM and passes -Dtest.heap=1024m: with 512m the run of 2026-10-13 ran out
             of heap about 200 classes in. -->
        <test.heap>512m</test.heap>
        <test.argLine>-Xmx${test.heap} -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Djdk.httpclient.allowRestrictedHeaders=host</test.argLine>
        <!-- Tags left out of a normal test run. deploy: needs the app image, runs in the CI image job. -->
        <test.excludedGroups>openapi,deploy</test.excludedGroups>
        <test.groups></test.groups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Sessions, CSRF, security headers, and role checks (architecture.md section 5). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Server sessions in the database: tables spring_session and spring_session_attributes (V1). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <!-- Argon2id password hashes (AUTH-5). Spring Security's Argon2 encoder needs Bouncy Castle. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- OIDC sign-in (AUTH-6, ADR D-64): the token exchange, ID token checks, and JWKS signatures.
             Not the Boot starter: no oauth2Login() and no auto-configuration, which would reach the provider
             at startup. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <!-- Outgoing email over SMTP (Jakarta Mail with Eclipse Angus), one connection per email. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- /actuator/prometheus on the management port (S0-AC-78). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Reads WebP profile photos (ADR D-53). Pure Java, reading only; the JDK reads PNG and JPEG
             itself. Brings five more jars of the same project (imageio-core, imageio-metadata,
             common-lang, common-io, common-image). -->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>3.15.3</version>
        </dependency>
        <!-- Parses the Markdown of an issue to collect the text it shows, for the search (ADR D-56).
             One jar, pure Java, no dependencies. Parsing only: no HTML renderer, no extensions. -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.30.0</version>
        </dependency>
        <!-- Turns the HTML part of a received email into text when it has no text part (MAILIN-4, ADR D-67).
             One jar, pure Java, no dependencies. Parsing only: no fetching of URLs. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
        </dependency>
        <!-- Attachments in S3-compatible storage, POPDESK_STORAGE=s3 (ADR D-38, D-60). Only the JDK's
             URL connection as the HTTP client: the SDK's other clients (Netty, Apache 4 and 5) are left
             out, which keeps this at 32 jars and 8.7 MB. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${awssdk.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache5-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>${awssdk.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>2.1.14</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- One forked JVM, test classes one after another. -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                    <argLine>${test.argLine}</argLine>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ./mvnw -Popenapi test: writes docs/integrate/openapi-portal.json and openapi-console.json. -->
        <profile>
            <id>openapi</id>
            <properties>
                <test.groups>openapi</test.groups>
                <test.excludedGroups></test.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <popdesk.openapi.dir>${project.basedir}/../docs/integrate</popdesk.openapi.dir>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Mutation tests (PIT), one part at a time. Not part of a normal build or of CI.
             ./mvnw -Ppit test-compile org.pitest:pitest-maven:mutationCoverage -Dpit.part=attachment
                 "-DtargetClasses=io.popdesk.helpdesk.attachment.*" "-DtargetTests=io.popdesk.attachment.*"
             Reports: target/pit-reports/<part>. No history file: PIT 1.30.0 runs history only with the
             arcmutate plugin, which needs a licence. -->
        <profile>
            <id>pit</id>
            <properties>
                <pit.part>all</pit.part>
                <pit.timeoutConstant>8000</pit.timeoutConstant>
                <!-- test.argLine with G1. PIT ends a minion with MEMORY_ERROR when a memory pool passes 90%
                     of its maximum, garbage included; with the serial collector at 512m the old generation
                     (341 MB) does. The normal test run keeps test.argLine. -->
                <pit.argLine>-Xmx512m -XX:+UseG1GC -XX:TieredStopAtLevel=1 -Djdk.httpclient.allowRestrictedHeaders=host</pit.argLine>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.0</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- targetClasses, targetTests, excludedClasses, excludedMethods, and
                                 excludedTestClasses come from the command line (-D), part by part. -->
                            <threads>1</threads>
                            <!-- Off: PIT would add the Surefire argLine after this one, and its -Xmx512m wins. -->
                            <parseSurefireConfig>false</parseSurefireConfig>
                            <argLine>${pit.argLine}</argLine>
                            <excludedGroups>
                                <param>openapi</param>
                                <param>deploy</param>
                            </excludedGroups>
                            <timeoutConstant>${pit.timeoutConstant}</timeoutConstant>
                            <timestampedReports>false</timestampedReports>
                            <reportsDirectory>${project.build.directory}/pit-reports/${pit.part}</reportsDirectory>
                            <outputFormats>
                                <param>XML</param>
                                <param>CSV</param>
                                <param>HTML</param>
                            </outputFormats>
                            <failWhenNoMutations>false</failWhenNoMutations>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
