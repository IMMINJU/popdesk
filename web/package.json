{
  "name": "popdesk-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^24.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "gen:api": "pnpm --filter @popdesk/api run gen:api",
    "changed:build": "pnpm --filter \"...[origin/main]\" run build",
    "changed:test": "pnpm --filter \"...[origin/main]\" --workspace-concurrency=1 run test",
    "changed:typecheck": "pnpm --filter \"...[origin/main]\" run typecheck",
    "changed:lint": "pnpm --filter \"...[origin/main]\" run lint",
    "dup": "jscpd --config .jscpd.json console/src portal/src packages/app/src packages/ui/src packages/i18n/src"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jscpd": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
